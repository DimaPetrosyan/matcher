{
  "name": "matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.mts",
  "scripts": {
    "dev": "bun --watch src/index.mts",
    "start": "bun src/index.mts",
    "build": "bun build src/index.mts --compile --outfile matcher",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.mts\" \"test/**/*.mts\"",
    "db:pull": "bunx drizzle-kit pull && mv src/database/schema.ts src/database/schema.mts",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:typecheck": "bun run --cwd web typecheck"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.32.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
